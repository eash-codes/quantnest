# ── Authentication (required) ────────────────────────────────────────────
# Signing key for JWTs. Generate with:  openssl rand -hex 32
# Must be at least 32 characters. The app refuses to start in production
# without it, and rotating it invalidates every existing session.
JWT_SECRET_KEY=

# Short-lived token sent on every request; refreshed automatically.
ACCESS_TOKEN_TTL_MINUTES=30
# Long-lived token, only ever presented to /auth/refresh.
REFRESH_TOKEN_TTL_DAYS=7

# "production" or "staging" makes JWT_SECRET_KEY mandatory.
ENVIRONMENT=development

# ── Rate limiting ────────────────────────────────────────────────────────
# In-process fixed-window counters guarding the auth endpoints.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600

# ── Database ─────────────────────────────────────────────────────────────
# SQLite by default. Switch to PostgreSQL by changing this line only:
#   DATABASE_URL=postgresql+psycopg://quantnest:quantnest@db:5432/quantnest
DATABASE_URL=sqlite:///./quantnest.db

# Echo every SQL statement (noisy; debugging only)
SQL_ECHO=false

# ── Market data ──────────────────────────────────────────────────────────
# yfinance = live prices | fake = deterministic prices for offline dev and CI
QUANTNEST_MARKET_PROVIDER=yfinance

# ── Logging ──────────────────────────────────────────────────────────────
# json = structured production logs | console = readable local output
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (build-time) ────────────────────────────────────────────────
# Vite inlines this at build time, so it must be the URL the browser uses.
VITE_API_URL=http://localhost:8000

# ── Postgres (only for: docker compose --profile postgres up) ────────────
POSTGRES_USER=quantnest
POSTGRES_PASSWORD=quantnest
POSTGRES_DB=quantnest
